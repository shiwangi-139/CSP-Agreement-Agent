# Copy to .env and fill in. Key names only -- no real values in this file.

# Database (use a SEPARATE database for tests; tests refuse to run on the main one)
DATABASE_URL=
TEST_DATABASE_URL=

# Access
ADMIN_API_KEY=
AGENT_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata

# Gmail (OAuth files live next to this file; run scripts/authenticate_gmail.py once)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=gmail_token.json
GMAIL_SCAN_INTERVAL_MINUTES=3
GMAIL_BACKFILL_DAYS=730
# Leave empty: CSPs write from personal mail; matching uses the calling sheet
EMAIL_SENDER_ALLOWLIST=

# Calling sheet: local_xlsx while testing, google at deployment
CALLING_SHEET_SOURCE=local_xlsx
CALLING_SHEET_LOCAL_PATH=CSP Details.xlsx
CALLING_SHEET_TAB=Calling Sheet New
CALLING_SHEET_SPREADSHEET_ID=

# Outbound: review (drafts need approval) or auto
OUTBOUND_COMMUNICATION_MODE=review
# WhatsApp agent: stub, push or pull
WHATSAPP_MODE=stub
WHATSAPP_AGENT_URL=
WHATSAPP_AGENT_TOKEN=

# Reading documents (all free)
OCR_ENGINE=tesseract
# Parallel Tesseract runs (default: CPU count - 1, max 3) and the OCR text cache
OCR_WORKERS=3
OCR_CACHE=on
OCR_DPI=220
# Empty = no local vision model on this machine (the rack server sets it)
LOCAL_VLM_URL=
LOCAL_VLM_TIMEOUT_SECONDS=60
LOCAL_VLM_MODEL=qwen2.5vl:7b
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
MAX_UPLOAD_SIZE_BYTES=30000000

# Document vault (app/vault.py). Relative = inside the project folder.
# Rack server: an absolute path such as /srv/sbi_kiosk/documents
STORAGE_ROOT=storage/sbi_kiosk/documents
# Rack server mounted over SSHFS: STORAGE_ROOT=/home/<you>/rack_vault/documents
# and STORAGE_REQUIRE_MARKER=on (refuses to write if the mount is down)
STORAGE_REQUIRE_MARKER=off
# Upload links stay valid this many days after the latest message was sent
PORTAL_TOKEN_DAYS=14
